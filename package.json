{
  "name": "histoday",
  "private": true,
  "version": "0.1.0",
  "description": "What happened on this day in history, as a stack of story cards.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "dependencies": {
    "@fontsource/sofia-sans": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0"
  }
}
